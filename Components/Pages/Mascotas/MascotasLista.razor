@page "/mascotas"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IMascotaService MascotaService
@inject ISesionService SesionService

@* Cliente: "Mis mascotas" (solo las suyas). Veterinario: pacientes (solo lectura).
   Administrador: todas, con edición y baja. *@

<PageTitle>VetCare Web - Mascotas</PageTitle>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 fw-bold text-primary mb-0">@Titulo</h1>
        @if (PuedeEditar)
        {
            <a href="mascotas/nueva" class="btn btn-success fw-bold">+ Registrar Mascota</a>
        }
    </div>

    @* Búsqueda rápida (RF-08) *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="input-group">
                <input type="search" class="form-control" placeholder="@(sesion?.EsCliente == true ? "Buscar por nombre, especie o raza..." : "Buscar por nombre, especie, raza, propietario o teléfono...")"
                       @bind="filtro" @bind:event="oninput" @onkeyup="BuscarConEnter" />
                <button class="btn btn-primary" @onclick="CargarAsync">Buscar</button>
            </div>
        </div>
    </div>

    @if (mensaje is not null)
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger")">@mensaje</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Paciente</th>
                            <th>Especie / Raza</th>
                            <th>Sexo</th>
                            <th>Edad</th>
                            <th>Peso</th>
                            @if (sesion?.EsCliente == false)
                            {
                                <th>Propietario</th>
                            }
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (mascotas is null)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">Cargando...</td></tr>
                        }
                        else if (mascotas.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    @if (string.IsNullOrWhiteSpace(filtro) && PuedeEditar)
                                    {
                                        <span>Aún no hay mascotas registradas. <a href="mascotas/nueva">Registra la primera</a>.</span>
                                    }
                                    else
                                    {
                                        <span>No se encontraron mascotas.</span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var m in mascotas)
                            {
                                <tr>
                                    <td><a href="mascotas/@m.Id" class="fw-bold text-decoration-none">@m.Nombre</a></td>
                                    <td>@m.Especie<br /><span class="text-muted small">@(m.Raza ?? "Sin raza")</span></td>
                                    <td>@m.Sexo</td>
                                    <td>@Textos.Edad(m.FechaNacimiento)</td>
                                    <td>@Textos.Peso(m.PesoKg)</td>
                                    @if (sesion?.EsCliente == false)
                                    {
                                        <td>
                                            @m.Propietario?.Usuario.Nombre<br />
                                            <span class="text-muted small">@m.Propietario?.Telefono</span>
                                        </td>
                                    }
                                    <td class="text-end text-nowrap">
                                        @if (confirmarId == m.Id)
                                        {
                                            <span class="small me-2">¿Eliminar a @(m.Nombre)?</span>
                                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarAsync(m.Id)">Sí</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => confirmarId = null">No</button>
                                        }
                                        else
                                        {
                                            <a href="mascotas/@m.Id" class="btn btn-outline-primary btn-sm">Expediente</a>
                                            if (PuedeEditar)
                                            {
                                                <a href="citas/nueva?mascota=@m.Id" class="btn btn-outline-success btn-sm">Agendar</a>
                                                <a href="mascotas/editar/@m.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmarId = m.Id">Eliminar</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (sesion?.EsAdmin == true)
    {
        <p class="small text-muted mt-2">Al eliminar una mascota también se borran sus citas, consultas y vacunas.</p>
    }
</div>

@code {
    private UsuarioSesion? sesion;
    private List<Mascota>? mascotas;
    private string? filtro;
    private int? confirmarId;      // fila que está pidiendo confirmación de borrado
    private string? mensaje;
    private bool exito;

    private bool PuedeEditar => sesion is not null && (sesion.EsAdmin || sesion.EsCliente);

    private string Titulo => sesion switch
    {
        { EsCliente: true } => "Mis Mascotas",
        { EsVet: true } => "Pacientes",
        _ => "Gestión de Mascotas"
    };

    protected override async Task OnInitializedAsync()
    {
        sesion = await SesionService.ObtenerAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        mascotas = await MascotaService.ObtenerTodasAsync(filtro);
    }

    private async Task BuscarConEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var resultado = await MascotaService.EliminarAsync(id);
        exito = resultado.Exito;
        mensaje = resultado.Exito ? "Mascota eliminada." : resultado.Mensaje;
        confirmarId = null;
        await CargarAsync();
    }
}
