@page "/propietarios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RolesApp.Personal)]
@inject IPropietarioService PropietarioService
@inject IUsuarioService UsuarioService
@inject ISesionService SesionService

@* Administrador: CRUD completo y activar/desactivar cuentas.
   Veterinario: consulta (RF-08) para contactar a los propietarios. *@

<PageTitle>VetCare Web - Propietarios</PageTitle>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 fw-bold text-primary mb-0">Propietarios</h1>
        @if (esAdmin)
        {
            <a href="propietarios/nuevo" class="btn btn-success fw-bold">+ Registrar Propietario</a>
        }
    </div>

    @* Búsqueda rápida (RF-08) *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="input-group">
                <input type="search" class="form-control" placeholder="Buscar por nombre, correo, teléfono o nombre de mascota..."
                       @bind="filtro" @bind:event="oninput" @onkeyup="BuscarConEnter" />
                <button class="btn btn-primary" @onclick="CargarAsync">Buscar</button>
            </div>
        </div>
    </div>

    @if (mensaje is not null)
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger")">@mensaje</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Propietario</th>
                            <th>Teléfono</th>
                            <th>Dirección</th>
                            <th>Contacto de Emergencia</th>
                            <th>Mascotas</th>
                            @if (esAdmin)
                            {
                                <th>Cuenta</th>
                                <th class="text-end">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (propietarios is null)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">Cargando...</td></tr>
                        }
                        else if (propietarios.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron propietarios.</td></tr>
                        }
                        else
                        {
                            foreach (var p in propietarios)
                            {
                                <tr>
                                    <td>
                                        <strong>@p.Usuario.Nombre</strong><br />
                                        <span class="text-muted small">@p.Usuario.Email</span>
                                    </td>
                                    <td>@(p.Telefono ?? "-")</td>
                                    <td class="small">@(p.Direccion ?? "-")</td>
                                    <td class="small">@(p.ContactoEmergencia ?? "-")</td>
                                    <td>
                                        @if (p.Mascotas.Count == 0)
                                        {
                                            <span class="text-muted small">Sin mascotas</span>
                                        }
                                        @foreach (var m in p.Mascotas)
                                        {
                                            <a href="mascotas/@m.Id" class="badge bg-info text-white text-decoration-none me-1">@m.Nombre</a>
                                        }
                                    </td>
                                    @if (esAdmin)
                                    {
                                        <td>
                                            <span class="badge @(p.Usuario.Activo ? "bg-success" : "bg-secondary")">@(p.Usuario.Activo ? "Activa" : "Inactiva")</span>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (confirmarId == p.Id)
                                            {
                                                <span class="small me-2">¿Eliminar cuenta, @p.Mascotas.Count mascota(s) y sus expedientes?</span>
                                                <button class="btn btn-danger btn-sm" @onclick="() => EliminarAsync(p.Id)">Sí</button>
                                                <button class="btn btn-secondary btn-sm" @onclick="() => confirmarId = null">No</button>
                                            }
                                            else
                                            {
                                                <a href="mascotas/nueva?propietario=@p.Id" class="btn btn-outline-success btn-sm">+ Mascota</a>
                                                <a href="propietarios/editar/@p.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => CambiarActivoAsync(p.UsuarioId, !p.Usuario.Activo)">
                                                    @(p.Usuario.Activo ? "Desactivar" : "Activar")
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmarId = p.Id">Eliminar</button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (esAdmin)
    {
        <p class="small text-muted mt-2">
            Una cuenta desactivada no puede iniciar sesión, pero conserva sus mascotas y expedientes.
            Eliminar borra todo de forma permanente.
        </p>
    }
</div>

@code {
    private List<Propietario>? propietarios;
    private bool esAdmin;
    private string? filtro;
    private int? confirmarId;
    private string? mensaje;
    private bool exito;

    protected override async Task OnInitializedAsync()
    {
        esAdmin = (await SesionService.ObtenerAsync()).EsAdmin;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        propietarios = await PropietarioService.ObtenerTodosAsync(filtro);
    }

    private async Task BuscarConEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CargarAsync();
    }

    private async Task CambiarActivoAsync(int usuarioId, bool activo)
    {
        var resultado = await UsuarioService.CambiarActivoAsync(usuarioId, activo);
        exito = resultado.Exito;
        mensaje = resultado.Exito ? (activo ? "Cuenta activada." : "Cuenta desactivada.") : resultado.Mensaje;
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var resultado = await PropietarioService.EliminarAsync(id);
        exito = resultado.Exito;
        mensaje = resultado.Exito ? "Propietario eliminado." : resultado.Mensaje;
        confirmarId = null;
        await CargarAsync();
    }
}
