@page "/admin/personal"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RolesApp.Admin)]
@inject IUsuarioService UsuarioService
@inject ISesionService SesionService

@* Gestión de cuentas del personal (solo administrador): alta de veterinarios
   y administradores, edición, restablecer contraseña y activar/desactivar. *@

<PageTitle>VetCare Web - Personal</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 fw-bold text-primary mb-0">Personal de la clínica</h1>
        <button class="btn btn-success fw-bold" @onclick="Nuevo">+ Nuevo integrante</button>
    </div>

    @if (mensaje is not null)
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger")">@mensaje</div>
    }

    <div class="row g-4">
        @* LISTA *@
        <div class="col-12 @(form is null ? "" : "col-lg-7")">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Rol</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (personal is null)
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-4">Cargando...</td></tr>
                                }
                                else
                                {
                                    foreach (var u in personal)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@u.Nombre</strong>
                                                @if (u.Id == miId)
                                                {
                                                    <span class="badge bg-light text-dark ms-1">Tú</span>
                                                }
                                                <br /><span class="text-muted small">@u.Email</span>
                                            </td>
                                            <td>@Textos.Rol(u.Rol)</td>
                                            <td>
                                                <span class="badge @(u.Activo ? "bg-success" : "bg-secondary")">@(u.Activo ? "Activo" : "Inactivo")</span>
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => EditarAsync(u.Id)">Editar</button>
                                                @if (u.Id != miId)
                                                {
                                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => CambiarActivoAsync(u.Id, !u.Activo)">
                                                        @(u.Activo ? "Desactivar" : "Activar")
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <p class="small text-muted mt-2">
                Las cuentas del personal no se eliminan: se desactivan, para conservar el historial de citas y consultas.
            </p>
        </div>

        @* FORMULARIO *@
        @if (form is not null)
        {
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white fw-bold py-3">
                        @(form.Id == 0 ? "Nuevo integrante" : "Editar integrante")
                    </div>
                    <div class="card-body p-4">
                        <EditForm Model="form" OnValidSubmit="GuardarAsync" FormName="personalForm">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Nombre:</label>
                                <InputText class="form-control" placeholder="Ej. Dra. Ana Martínez" @bind-Value="form.Nombre" />
                                <ValidationMessage For="() => form.Nombre" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Correo:</label>
                                <InputText type="email" class="form-control" @bind-Value="form.Email" />
                                <ValidationMessage For="() => form.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Rol:</label>
                                <InputSelect class="form-select" @bind-Value="form.Rol" disabled="@(form.Id == miId)">
                                    <option value="@RolUsuario.Vet">Veterinario</option>
                                    <option value="@RolUsuario.Admin">Administrador</option>
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">
                                    @(form.Id == 0 ? "Contraseña:" : "Nueva contraseña (opcional):")
                                </label>
                                <InputText type="password" class="form-control" @bind-Value="form.Password" autocomplete="new-password"
                                           placeholder="@(form.Id == 0 ? "Mínimo 6 caracteres" : "Dejar vacía para no cambiarla")" />
                            </div>

                            @if (form.Id != 0 && form.Id != miId)
                            {
                                <div class="form-check mb-3">
                                    <InputCheckbox id="activo" class="form-check-input" @bind-Value="form.Activo" />
                                    <label class="form-check-label" for="activo">Cuenta activa</label>
                                </div>
                            }

                            @if (error is not null)
                            {
                                <div class="alert alert-danger py-2">@error</div>
                            }

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success fw-bold px-4">Guardar</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="Cerrar">Cancelar</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Usuario>? personal;
    private PersonalFormModel? form;   // null = formulario cerrado
    private int miId;
    private string? mensaje;
    private bool exito;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        miId = (await SesionService.ObtenerAsync()).Id;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        personal = await UsuarioService.ObtenerPersonalAsync();
    }

    private void Nuevo()
    {
        form = new PersonalFormModel();
        error = null;
        mensaje = null;
    }

    private async Task EditarAsync(int id)
    {
        form = await UsuarioService.ObtenerFormularioPersonalAsync(id);
        error = null;
        mensaje = null;
    }

    private void Cerrar() => form = null;

    private async Task GuardarAsync()
    {
        if (form is null) return;

        var esNuevo = form.Id == 0;
        var resultado = await UsuarioService.GuardarPersonalAsync(form);
        if (!resultado.Exito)
        {
            error = resultado.Mensaje;
            return;
        }

        exito = true;
        mensaje = esNuevo ? $"Se creó la cuenta de {form.Nombre}." : $"Se actualizaron los datos de {form.Nombre}.";
        form = null;
        await CargarAsync();
    }

    private async Task CambiarActivoAsync(int id, bool activo)
    {
        var resultado = await UsuarioService.CambiarActivoAsync(id, activo);
        exito = resultado.Exito;
        mensaje = resultado.Exito ? (activo ? "Cuenta activada." : "Cuenta desactivada.") : resultado.Mensaje;
        await CargarAsync();
    }
}
