@* Módulos del sistema (características y servicios) de Actividad8.html *@

<section id="servicios" class="mb-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Módulos de la Aplicación VetCare Web</h2>
        <p class="text-muted">Herramientas digitales diseñadas para clientes, veterinarios y administradores</p>
    </div>
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-4 text-center">
                    <h3 class="h5 fw-bold text-primary mb-3">Gestión de Mascotas</h3>
                    <p class="card-text text-muted">
                        Registro completo de propietarios y pacientes animales (nombre, especie, raza, fecha de nacimiento, peso y sexo).
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-4">
                    <span class="badge bg-info text-white p-2">Módulo RF-03 / RF-02</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-4 text-center">
                    <h3 class="h5 fw-bold text-primary mb-3">Expediente Clínico Electrónico</h3>
                    <p class="card-text text-muted">
                        Captura detallada de diagnósticos, síntomas, peso actual, tratamientos prescritos e indicaciones médicas por consulta.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-4">
                    <span class="badge bg-info text-white p-2">Módulo RF-06</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-4 text-center">
                    <h3 class="h5 fw-bold text-primary mb-3">Carnet Digital de Vacunación</h3>
                    <p class="card-text text-muted">
                        Seguimiento interactivo de vacunas y desparasitaciones aplicadas indicando lote, fecha y próxima dosis programada.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-4">
                    <span class="badge bg-info text-white p-2">Módulo RF-07</span>
                </div>
            </div>
        </div>
    </div>
</section>
