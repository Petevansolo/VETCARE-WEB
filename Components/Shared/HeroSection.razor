@* Sección Hero (presentación principal) de Actividad8.html.
   Los botones cambian según si hay sesión iniciada. *@

<header id="inicio" class="bg-white py-5 border-bottom mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold text-primary mb-3">Plataforma Web de Gestión Veterinaria 'VetCare Web'</h1>
                <p class="lead text-secondary mb-4">
                    Solución integral multiusuario para el agendamiento de citas en tiempo real, administración de propietarios, expediente clínico electrónico y carnet de vacunación digital.
                </p>
                <AuthorizeView>
                    <Authorized>
                        <a href="panel" class="btn btn-primary btn-lg me-2 shadow-sm">Ir a mi panel</a>
                        <AuthorizeView Roles="@RolesApp.AdminOCliente" Context="rolContext">
                            <a href="citas/nueva" class="btn btn-outline-primary btn-lg">Agendar cita</a>
                        </AuthorizeView>
                    </Authorized>
                    <NotAuthorized>
                        <a href="cuenta/registro" class="btn btn-primary btn-lg me-2 shadow-sm">Crear cuenta gratis</a>
                        <a href="cuenta/login" class="btn btn-outline-primary btn-lg">Iniciar sesión</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <div class="col-md-4 text-center mt-4 mt-md-0">
                <div class="p-4 bg-light rounded-3 border">
                    <h4 class="text-primary fw-bold mb-2">Estado del Sistema</h4>
                    <p class="text-muted mb-2">Clínica Veterinaria Central</p>
                    <span class="badge bg-success fs-6">Operativo 24/7</span>
                    <p class="small text-muted mt-3 mb-0">Atención: @HorarioClinica.Descripcion</p>
                </div>
            </div>
        </div>
    </div>
</header>
